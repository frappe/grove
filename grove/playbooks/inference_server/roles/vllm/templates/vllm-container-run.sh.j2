#!/bin/sh
{#
  Rendered by the vllm role — do not edit on the box; Update Engine Config re-renders and re-runs it.
  --ipc=host: tensor-parallel > 1 needs host shared memory.
#}
set -eu

docker stop {{ vllm_unit }} >/dev/null 2>&1 || true
docker rm -f {{ vllm_unit }} >/dev/null 2>&1 || true

{% if vllm_cache_bucket %}
{{ vllm_cache_sync_script }} pull || true
{% endif %}
docker run --detach --restart unless-stopped --name {{ vllm_unit }} \
{% if vllm_cuda_visible_devices | length > 0 %}
  --gpus '"device={{ vllm_cuda_visible_devices }}"' \
{% else %}
  --gpus all \
{% endif %}
  --ipc=host \
  -p {{ vllm_port }}:{{ vllm_port }} \
  -v {{ vllm_hf_home }}:/root/.cache/huggingface \
  -v {{ vllm_cache_dir }}:/root/.cache/vllm \
  --env-file {{ vllm_container_env_file }} \
  --log-opt max-size=100m --log-opt max-file=5 \
  {{ vllm_image }}{% if vllm_model %} {{ vllm_model }}{% endif %}{% for arg in vllm_serve_args %} '{{ arg }}'{% endfor %}

{% if vllm_cache_bucket %}
nohup {{ vllm_cache_sync_script }} push >/dev/null 2>&1 &
{% endif %}
