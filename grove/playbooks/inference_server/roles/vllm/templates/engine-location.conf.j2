{# Rendered by the vllm role — do not edit on the box. A bare location: the engine proxy's server block includes it. #}
location /e/{{ vllm_instance }}/ {
{% if vllm_engine_kind == 'custom' %}
	# A blank key renders `!= "Bearer "` and refuses everything, which is the direction to fail in.
	if ($http_authorization != "Bearer {{ vllm_api_key }}") { return 401; }
{% endif %}
	# The trailing slash is what strips the /e/{{ vllm_instance }}/ prefix before the engine sees it.
	proxy_pass http://127.0.0.1:{{ vllm_port }}/;
	proxy_http_version 1.1;
	proxy_set_header Connection "";
	proxy_buffering off;
	proxy_read_timeout 600s;
	proxy_send_timeout 600s;
}
