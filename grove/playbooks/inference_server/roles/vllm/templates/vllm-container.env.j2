{# docker --env-file: KEY=value, no quoting, the rest of the line verbatim. #}
TRITON_CACHE_DIR=/root/.cache/vllm/triton
TORCHINDUCTOR_CACHE_DIR=/root/.cache/vllm/torchinductor
{% if vllm_predownload_model and not vllm_download_glob %}
{#
  Offline, or the engine resolves `main` itself and fetches a new revision inline, under the
  health gate. Not for a GGUF ref: its config and tokenizer are still fetched at boot.
#}
HF_HUB_OFFLINE=1
{% endif %}
{% for key, value in vllm_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% if vllm_effective_api_key | length > 0 %}
VLLM_API_KEY={{ vllm_effective_api_key }}
{% endif %}
