{# Rendered by the redis role — do not edit on the box. What is not set here is redis's own default. #}
bind {{ redis_bind if redis_password else '127.0.0.1' }}
port 6379
{% if redis_password %}
requirepass {{ redis_password }}
{% endif %}
daemonize no
supervised systemd
dir /var/lib/store-redis
logfile /var/log/store-redis/redis.log
appendonly yes
appendfsync everysec
maxmemory-policy noeviction
save 3600 1 300 100 60 10000
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 256mb
no-appendfsync-on-rewrite no
stop-writes-on-bgsave-error yes
