{# Rendered by the vector role — do not edit on the box. Both sinks are datum routes; the token names this machine. #}
data_dir: /var/lib/vector
api:
  enabled: true
  address: "{{ vector_api_address }}"

sources:
{% if vector_ship_host_metrics %}
  host:
    type: host_metrics
    scrape_interval_secs: {{ vector_metrics_interval_seconds }}
    collectors: {{ vector_host_collectors | tojson }}
    network: {devices: {excludes: {{ vector_host_network_excludes | tojson }}}}
    disk: {devices: {excludes: {{ vector_host_disk_excludes | tojson }}}}
    filesystem: {filesystems: {excludes: {{ vector_host_filesystem_excludes | tojson }}}}
{% endif %}
{% if vector_redis_password %}
  # The redis exporter beside Vector on a store: memory, clients, evictions, persistence, as redis_* series.
  redis:
    type: prometheus_scrape
    endpoints: ["{{ vector_redis_exporter_url }}"]
    scrape_interval_secs: {{ vector_metrics_interval_seconds }}
{% endif %}
  # Queue depth and errors: how a broken pipeline announces itself. Ships whatever the switch says.
  vector_self:
    type: internal_metrics
    scrape_interval_secs: {{ vector_metrics_interval_seconds }}
  files:
    type: file
    include: {{ vector_log_files | tojson }}
    ignore_older_secs: 86400
    # A payload line tops Vector's 100 KiB default and would be dropped whole; datum takes a 12 MiB body.
    max_line_bytes: {{ vector_log_max_line_bytes }}

transforms:
  labelled_metrics:
    type: remap
    inputs: [{% if vector_ship_host_metrics %}host, {% endif %}{% if vector_redis_password %}redis, {% endif %}vector_self]
    source: |
      .tags.server = "{{ vector_server }}"
      .tags.machine = "{{ vector_machine }}"
      .tags.region = "{{ vector_region }}"
  # datum's line: ts, product, service, level, source, message, attributes. pathway writes slog JSON, so its
  # level and msg become datum's and every other key an attribute, groups flattened with _ (latency_total_ms);
  # a prompt or output ships whole. Only datum's own 8 KiB message cap applies, to a line that is not JSON.
  datum_lines:
    type: remap
    inputs: [files]
    source: |
      parts = split(string!(.file), "/")
      source = parts[-1]
      line = string(.message) ?? ""
      level = if source == "error.log" { "error" } else { "info" }
      message = line
      attributes = {
        "host": .host,
        "server": "{{ vector_server }}",
        "machine": "{{ vector_machine }}",
        "region": "{{ vector_region }}"
      }
      parsed, err = parse_json(line)
      if err == null && is_object(parsed) {
        parsed = object!(parsed)
        level = downcase(string(parsed.level) ?? level)
        message = string(parsed.msg) ?? ""
        del(parsed.time)
        del(parsed.level)
        del(parsed.msg)
        values = map_values(flatten(compact(parsed), "_")) -> |value| { if is_string(value) { value } else { encode_json(value) } }
        attributes = merge(attributes, values)
      } else if length(line) > 8192 {
        attributes.line = line
        message = truncate(line, 8192)
      }
      . = {
        "ts": format_timestamp!(.timestamp, "%+"),
        "product": "grove",
        "service": parts[-2],
        "level": level,
        "source": source,
        "message": message,
        "attributes": attributes
      }

# Healthchecks off on both: datum answers 405 to a GET on an ingest route, and `vector validate`
# in the unit's ExecStartPre would refuse to start on that. A full buffer drops the newest event
# rather than stall the sources.
sinks:
  metrics:
    type: prometheus_remote_write
    inputs: [labelled_metrics]
    endpoint: "{{ vector_metrics_url }}"
    auth:
      strategy: bearer
      token: "{{ vector_token }}"
    batch:
      max_events: {{ vector_batch_max_events }}
      timeout_secs: {{ vector_batch_timeout_seconds }}
    healthcheck:
      enabled: false
    buffer:
      type: disk
      max_size: {{ vector_buffer_max_bytes }}
      when_full: drop_newest
  logs:
    type: http
    inputs: [datum_lines]
    uri: "{{ vector_logs_url }}"
    auth:
      strategy: bearer
      token: "{{ vector_token }}"
    # One batch goes as one JSON array, which datum accepts bare.
    encoding:
      codec: json
    batch:
      max_events: {{ vector_batch_max_events }}
      max_bytes: {{ vector_batch_max_bytes }}
      timeout_secs: {{ vector_batch_timeout_seconds }}
    healthcheck:
      enabled: false
    buffer:
      type: disk
      max_size: {{ vector_buffer_max_bytes }}
      when_full: drop_newest
